{
  "name": "grep-quest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.ts",
    "start:lan": "HOST=0.0.0.0 PORT=3001 node server/index.ts",
    "test": "node --test tests/*.test.ts",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "@playwright/test": "^1.64.1"
  }
}
